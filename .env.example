# Site
NEXT_PUBLIC_SITE_URL=https://gorkycleaning.ru

# Yandex Metrika
NEXT_PUBLIC_YANDEX_METRIKA_ID=110396882

# Telegram Bot — уведомления о новых заявках
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Если VPS не видит api.telegram.org (Timeweb и др.) — Cloudflare Worker proxy:
# TELEGRAM_API_BASE=https://your-worker.workers.dev
# TELEGRAM_PROXY_SECRET=your_random_secret

# Альтернатива: HTTP/SOCKS прокси на самом VPS
# TELEGRAM_PROXY_URL=http://127.0.0.1:8080

# PostgreSQL (runtime role: gorky_app — минимальные DML-права)
# Локально / VPS loopback — без SSL:
DATABASE_URL=postgresql://gorky_app:CHANGE_ME@127.0.0.1:5432/gorky_db
DATABASE_SSL=disable

# Внешняя БД с TLS:
# DATABASE_URL=postgresql://gorky_app:CHANGE_ME@db.example.com:5432/gorky_db
# DATABASE_SSL=require
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Pepper for hashing client IPs (do not reuse Telegram secrets)
LEAD_IP_HASH_PEPPER=change-me-to-a-long-random-string

# Optional spam rate limits (defaults shown)
# LEAD_RATE_LIMIT_IP_MAX=8
# LEAD_RATE_LIMIT_IP_WINDOW_MS=600000
# LEAD_RATE_LIMIT_PHONE_MAX=5
# LEAD_RATE_LIMIT_PHONE_WINDOW_MS=3600000
